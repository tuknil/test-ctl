# Copy this file to .env and fill in real values. Never commit the real .env file.

# Which mode the service runs in: "fixture" (default, offline/deterministic) or "live" (real model calls)
RUN_MODE=fixture

# Model provider. In fixture mode this can remain "none".
# Supported live examples: openai, azure-openai, att-inference
MODEL_PROVIDER=none

# Model name/deployment used by the translation agent. Required in live mode.
MODEL_NAME=not-configured

# API key for the configured model provider. Required only when RUN_MODE=live.
OPENAI_API_KEY=

# Optional: if using Azure OpenAI instead of public OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Optional: AT&T Inference, using its OpenAI-compatible endpoint.
# Set MODEL_PROVIDER=att-inference and RUN_MODE=live to enable it.
# Obtain the base URL, model ID, and API key from your AT&T Inference tenant.
ATT_INFERENCE_BASE_URL=
ATT_INFERENCE_API_KEY=

# Model HTTP timeout. Allowed range: 1-300 seconds.
MODEL_REQUEST_TIMEOUT_SECONDS=60

# HTTP server bind settings
HOST=0.0.0.0
PORT=8000

# Set false when API documentation is exposed through a controlled gateway
# or should not be publicly available.
ENABLE_DOCS=true
