# Copy this file to .env and fill in real values. Never commit the real .env file.

# Which mode the service runs in: "fixture" (default, offline/deterministic) or "live" (real model calls)
RUN_MODE=fixture

# Model provider. In fixture mode this can remain "none".
# Supported live examples: openai, azure-openai, att-inference
MODEL_PROVIDER=none

# Model name/deployment used by the translation agent. Required in live mode.
MODEL_NAME=not-configured

# API key for the configured model provider. Required only when RUN_MODE=live.
OPENAI_API_KEY=

# Optional: if using Azure OpenAI instead of public OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Optional: AT&T Inference, using its OpenAI-compatible endpoint.
# Set MODEL_PROVIDER=att-inference and RUN_MODE=live to enable it.
# Obtain the base URL, model ID, and API key from your AT&T Inference tenant.
ATT_INFERENCE_BASE_URL=
ATT_INFERENCE_API_KEY=

# Model HTTP timeout. Allowed range: 1-300 seconds.
MODEL_REQUEST_TIMEOUT_SECONDS=60

# Immutable result backend. Databricks mode still uses SQLite for lifecycle
# coordination and sends only completed capability results to Databricks.
PERSISTENCE_BACKEND=sqlite

# Durable single-instance SQLite lifecycle storage. Mount /app/data on durable
# storage in containers. DELETE journaling is required for this volume model.
DATABASE_PATH=/app/data/control_translation.db
SERVICE_REPLICA_COUNT=1

# Optional durable orchestration completion callbacks. Inject the token from
# Azure Container Apps secrets; never commit a real value to this file.
CAPABILITY_CALLBACK_TOKEN=
CAPABILITY_CALLBACK_ALLOWED_HOSTS=
CAPABILITY_CALLBACK_TIMEOUT_SECONDS=10
CAPABILITY_CALLBACK_POLL_INTERVAL_SECONDS=1

# Databricks SQL persistence. OAuth M2M is recommended for Azure deployments;
# PAT is allowed for temporary local testing. Never commit either secret.
# The Go service also accepts a single connection string instead of the four
# variables below, in the databricks-sql-go format. Explicit variables win over
# it. It embeds the token, so treat it like any other secret:
# DATABRICKS_DSN=token:<pat>@<host>:443/sql/1.0/warehouses/<id>
DATABRICKS_SERVER_HOSTNAME=adb-7405605071306757.17.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/866109ed7dfce51a
DATABRICKS_AUTH_TYPE=oauth-m2m
DATABRICKS_TOKEN=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CATALOG=36889_janus_dev
DATABRICKS_SCHEMA=control_translation
DATABRICKS_RESULTS_TABLE=control_translation_results

# Durable worker lease and recovery controls. Heartbeats must be shorter than
# leases. Attempts include the initial claim and stale-worker recoveries.
WORKER_POLL_SECONDS=0.25
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_SHUTDOWN_GRACE_SECONDS=2

# PoC-only single-target defaults. Caller-supplied values override these.
DEFAULT_TARGET_TECHNOLOGY=akamai-waf
DEFAULT_TARGET_POLICY_CONTEXT_ID=akamai-policy:example:rev-17

# HTTP server bind settings for the API service
HOST=0.0.0.0
PORT=8000

# Browser origins allowed to call the API cross-origin. The demo UI is a
# separate service on its own origin and must be listed here or the browser
# will block every call. Comma-separated, full origins, no path, no '*'.
# Empty (the default) means no browser may call the API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ---------------------------------------------------------------------------
# Demo UI service (control_translation_ui). Deployed separately from the API;
# a UI deployment needs only these three values and no credentials.
# ---------------------------------------------------------------------------

# The API base URL as the BROWSER resolves it. This value is published to the
# page, so it must never be an internal-only service name.
API_ENDPOINT=http://127.0.0.1:8000
UI_HOST=0.0.0.0
UI_PORT=8080

# Set false when API documentation is exposed through a controlled gateway
# or should not be publicly available.
ENABLE_DOCS=true
