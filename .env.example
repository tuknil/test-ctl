# Copy this file to .env and fill in real values. Never commit the real .env file.

# Which mode the service runs in: "fixture" (default, offline/deterministic) or "live" (real model calls)
RUN_MODE=fixture

# Model provider for the Pydantic AI translation agent. Examples: openai, anthropic, azure-openai
MODEL_PROVIDER=openai

# Model name/deployment used by the translation agent
MODEL_NAME=gpt-4o-mini

# API key for the configured model provider. Required only when RUN_MODE=live.
OPENAI_API_KEY=

# Optional: if using Azure OpenAI instead of public OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# HTTP server bind settings
HOST=0.0.0.0
PORT=8000
