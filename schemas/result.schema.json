{
  "$defs": {
    "BypassCounterexample": {
      "description": "Bounded bypass evidence preserved for a declined exhausted route.",
      "properties": {
        "counterexample_id": {
          "title": "Counterexample Id",
          "type": "string"
        },
        "sample_ref": {
          "title": "Sample Ref",
          "type": "string"
        },
        "variant_family": {
          "title": "Variant Family",
          "type": "string"
        },
        "observed_behavior": {
          "title": "Observed Behavior",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "counterexample_id",
        "sample_ref",
        "variant_family",
        "observed_behavior"
      ],
      "title": "BypassCounterexample",
      "type": "object"
    },
    "CandidateArtifact": {
      "properties": {
        "artifact_type": {
          "description": "akamai-waf-rule | firewall-rule | proxy-policy | edr-rule | other",
          "title": "Artifact Type",
          "type": "string"
        },
        "content_ref": {
          "title": "Content Ref",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "emitted_as": {
          "default": "control-specific-mitigation-candidate",
          "title": "Emitted As",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "content_ref",
        "content_hash"
      ],
      "title": "CandidateArtifact",
      "type": "object"
    },
    "CandidateMetadata": {
      "properties": {
        "syntax_profile": {
          "$ref": "#/$defs/CandidateSyntaxProfile"
        },
        "recommended_policy_binding": {
          "$ref": "#/$defs/RecommendedPolicyBinding"
        }
      },
      "required": [
        "syntax_profile",
        "recommended_policy_binding"
      ],
      "title": "CandidateMetadata",
      "type": "object"
    },
    "CandidateSyntaxProfile": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "validation_level": {
          "const": "shape-only",
          "default": "shape-only",
          "title": "Validation Level",
          "type": "string"
        },
        "deployment_ready": {
          "const": false,
          "default": false,
          "title": "Deployment Ready",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "family"
      ],
      "title": "CandidateSyntaxProfile",
      "type": "object"
    },
    "CollateralImpactPrior": {
      "properties": {
        "verdict": {
          "description": "low | medium | high | unknown | abstained",
          "title": "Verdict",
          "type": "string"
        },
        "confidence": {
          "description": "high | medium | low | unknown",
          "title": "Confidence",
          "type": "string"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "measured": {
          "default": false,
          "title": "Measured",
          "type": "boolean"
        }
      },
      "required": [
        "verdict",
        "confidence",
        "basis"
      ],
      "title": "CollateralImpactPrior",
      "type": "object"
    },
    "ControlTranslationResult": {
      "description": "Output contract. Field shape mirrors CFS \u00a72 `ControlTranslationResult`.",
      "properties": {
        "contract_id": {
          "default": "control-translation@1.0",
          "title": "Contract Id",
          "type": "string"
        },
        "result_id": {
          "title": "Result Id",
          "type": "string"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "input_bindings": {
          "$ref": "#/$defs/InputBindings"
        },
        "terminal_state": {
          "$ref": "#/$defs/TerminalState"
        },
        "outcome_reason": {
          "$ref": "#/$defs/OutcomeReason"
        },
        "proof_loop_qualification": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProofLoopQualification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bypass_counterexample": {
          "anyOf": [
            {
              "$ref": "#/$defs/BypassCounterexample"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "primary_candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrimaryCandidate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_bindings": {
          "items": {
            "$ref": "#/$defs/EvidenceBinding"
          },
          "title": "Evidence Bindings",
          "type": "array"
        },
        "prose_summary": {
          "title": "Prose Summary",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "subject",
        "input_bindings",
        "terminal_state",
        "outcome_reason",
        "prose_summary"
      ],
      "title": "ControlTranslationResult",
      "type": "object"
    },
    "DatabricksResultReference": {
      "additionalProperties": false,
      "description": "Authoritative pointer to one upstream result in Unity Catalog.",
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "catalog": {
          "title": "Catalog",
          "type": "string"
        },
        "schema": {
          "title": "Schema",
          "type": "string"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "system",
        "catalog",
        "schema",
        "table",
        "key"
      ],
      "title": "DatabricksResultReference",
      "type": "object"
    },
    "EvidenceBinding": {
      "properties": {
        "claim": {
          "description": "discriminator-preserved | target-feature-supported | policy-placement | limitation",
          "title": "Claim",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "claim"
      ],
      "title": "EvidenceBinding",
      "type": "object"
    },
    "ImplementsDiscriminator": {
      "properties": {
        "source_discriminator_id": {
          "title": "Source Discriminator Id",
          "type": "string"
        },
        "translation": {
          "description": "exact | equivalent | narrower",
          "title": "Translation",
          "type": "string"
        },
        "justification": {
          "title": "Justification",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "source_discriminator_id",
        "translation",
        "justification"
      ],
      "title": "ImplementsDiscriminator",
      "type": "object"
    },
    "InputBindings": {
      "properties": {
        "target_technology": {
          "title": "Target Technology",
          "type": "string"
        },
        "target_policy_context_id": {
          "title": "Target Policy Context Id",
          "type": "string"
        },
        "configured_poc_defaults_used": {
          "default": false,
          "title": "Configured Poc Defaults Used",
          "type": "boolean"
        },
        "current_policy_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Policy Snapshot Id"
        },
        "translation_policy_id": {
          "title": "Translation Policy Id",
          "type": "string"
        },
        "proof_record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Proof Record Ids",
          "type": "array"
        }
      },
      "required": [
        "target_technology",
        "target_policy_context_id",
        "translation_policy_id"
      ],
      "title": "InputBindings",
      "type": "object"
    },
    "OutcomeReason": {
      "properties": {
        "code": {
          "$ref": "#/$defs/OutcomeReasonCode"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "OutcomeReason",
      "type": "object"
    },
    "OutcomeReasonCode": {
      "description": "Reason codes bound to a terminal state, per CFS \u00a72 `outcome_reason.code`.",
      "enum": [
        "translated",
        "unsupported-target-technology",
        "unsupported-feature",
        "policy-conflict",
        "insufficient-policy-context",
        "insufficient-pattern-context",
        "invalid-input",
        "loop-exhausted-with-bypass",
        "bypass-found-requires-regeneration",
        "provider-failure",
        "result-assembly-failure"
      ],
      "title": "OutcomeReasonCode",
      "type": "string"
    },
    "Placement": {
      "properties": {
        "policy_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Section"
        },
        "ordering_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Ordering Constraints",
          "type": "array"
        },
        "conflict_notes": {
          "items": {
            "type": "string"
          },
          "title": "Conflict Notes",
          "type": "array"
        }
      },
      "title": "Placement",
      "type": "object"
    },
    "PrimaryCandidate": {
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "target_control_class": {
          "title": "Target Control Class",
          "type": "string"
        },
        "target_technology": {
          "title": "Target Technology",
          "type": "string"
        },
        "target_policy_context_id": {
          "title": "Target Policy Context Id",
          "type": "string"
        },
        "candidate_artifact": {
          "$ref": "#/$defs/CandidateArtifact"
        },
        "implements_discriminator": {
          "$ref": "#/$defs/ImplementsDiscriminator"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "inherited_collateral_impact_prior": {
          "$ref": "#/$defs/CollateralImpactPrior"
        },
        "translation_assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Translation Assumptions",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "provenance": {
          "items": {
            "type": "string"
          },
          "title": "Provenance",
          "type": "array"
        },
        "candidate_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "candidate_id",
        "target_control_class",
        "target_technology",
        "target_policy_context_id",
        "candidate_artifact",
        "implements_discriminator",
        "inherited_collateral_impact_prior"
      ],
      "title": "PrimaryCandidate",
      "type": "object"
    },
    "ProofLoopQualification": {
      "description": "Result qualification; loop exhaustion is not bypass clearance.",
      "properties": {
        "route": {
          "enum": [
            "validated",
            "poc-exhaustion"
          ],
          "title": "Route",
          "type": "string"
        },
        "bypass_cleared": {
          "title": "Bypass Cleared",
          "type": "boolean"
        },
        "loop_exhausted": {
          "title": "Loop Exhausted",
          "type": "boolean"
        },
        "completed_iterations": {
          "title": "Completed Iterations",
          "type": "integer"
        },
        "max_iterations": {
          "title": "Max Iterations",
          "type": "integer"
        },
        "bypass_validation_terminal_state": {
          "enum": [
            "no-bypass-found",
            "bypass-found"
          ],
          "title": "Bypass Validation Terminal State",
          "type": "string"
        },
        "bypass_validation_result_ref": {
          "$ref": "#/$defs/DatabricksResultReference"
        }
      },
      "required": [
        "route",
        "bypass_cleared",
        "loop_exhausted",
        "completed_iterations",
        "max_iterations",
        "bypass_validation_terminal_state",
        "bypass_validation_result_ref"
      ],
      "title": "ProofLoopQualification",
      "type": "object"
    },
    "RecommendedPolicyBinding": {
      "properties": {
        "action": {
          "const": "deny",
          "default": "deny",
          "title": "Action",
          "type": "string"
        },
        "attachment": {
          "const": "security-policy-custom-rule-binding",
          "default": "security-policy-custom-rule-binding",
          "title": "Attachment",
          "type": "string"
        },
        "embedded_in_artifact": {
          "const": false,
          "default": false,
          "title": "Embedded In Artifact",
          "type": "boolean"
        },
        "requires_operator_review": {
          "const": true,
          "default": true,
          "title": "Requires Operator Review",
          "type": "boolean"
        }
      },
      "title": "RecommendedPolicyBinding",
      "type": "object"
    },
    "ResultReference": {
      "description": "Stable API reference to a durable capability result.",
      "properties": {
        "system": {
          "default": "control-translation",
          "title": "System",
          "type": "string"
        },
        "type": {
          "default": "result-api",
          "title": "Type",
          "type": "string"
        },
        "result_id": {
          "title": "Result Id",
          "type": "string"
        },
        "href": {
          "title": "Href",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "href"
      ],
      "title": "ResultReference",
      "type": "object"
    },
    "Subject": {
      "properties": {
        "vulnerability_id": {
          "title": "Vulnerability Id",
          "type": "string"
        },
        "proven_pattern_id": {
          "title": "Proven Pattern Id",
          "type": "string"
        },
        "selected_control_class": {
          "title": "Selected Control Class",
          "type": "string"
        }
      },
      "required": [
        "vulnerability_id",
        "proven_pattern_id",
        "selected_control_class"
      ],
      "title": "Subject",
      "type": "object"
    },
    "TerminalState": {
      "description": "Terminal states the capability may emit for a single invocation.",
      "enum": [
        "translated",
        "cannot-express",
        "insufficient-context",
        "scope-declined",
        "malfunction"
      ],
      "title": "TerminalState",
      "type": "string"
    },
    "UpstreamResultReferences": {
      "additionalProperties": false,
      "description": "Role-bound proof-loop records required for referenced invocation.",
      "properties": {
        "defense_generation": {
          "$ref": "#/$defs/DatabricksResultReference"
        },
        "mitigation_check": {
          "$ref": "#/$defs/DatabricksResultReference"
        },
        "bypass_validation": {
          "$ref": "#/$defs/DatabricksResultReference"
        }
      },
      "required": [
        "defense_generation",
        "mitigation_check",
        "bypass_validation"
      ],
      "title": "UpstreamResultReferences",
      "type": "object"
    }
  },
  "properties": {
    "capability": {
      "default": "control-translation",
      "title": "Capability",
      "type": "string"
    },
    "contract_id": {
      "default": "control-translation@1.0",
      "title": "Contract Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "terminal_state": {
      "$ref": "#/$defs/TerminalState"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "result_ref": {
      "$ref": "#/$defs/ResultReference"
    },
    "upstream_result_refs": {
      "anyOf": [
        {
          "$ref": "#/$defs/UpstreamResultReferences"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "structured_result": {
      "$ref": "#/$defs/ControlTranslationResult"
    },
    "prose": {
      "title": "Prose",
      "type": "string"
    },
    "reference_bundle": {
      "additionalProperties": true,
      "title": "Reference Bundle",
      "type": "object"
    },
    "provenance": {
      "items": {
        "type": "string"
      },
      "title": "Provenance",
      "type": "array"
    },
    "confidence": {
      "additionalProperties": true,
      "title": "Confidence",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "trace": {
      "items": {
        "type": "string"
      },
      "title": "Trace",
      "type": "array"
    },
    "inference": {
      "additionalProperties": true,
      "title": "Inference",
      "type": "object"
    }
  },
  "required": [
    "result_id",
    "status",
    "terminal_state",
    "correlation_id",
    "result_ref",
    "structured_result",
    "prose"
  ],
  "title": "ResultEnvelope",
  "type": "object"
}